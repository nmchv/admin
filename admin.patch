+        </label>
+      </div>
+
+      {tables.error ? (
+        <ErrorState
+          message={`${tables.error}. Если ошибка про функцию cc_user_tables — примените миграцию 0005 в Supabase.`}
+          onRetry={tables.reload}
+        />
