+    } catch (e) {
+      toast('error', e instanceof Error ? e.message : 'Не удалось сохранить');
+      setBusy(false);
+    }
+  };
+
+  return (
+    <Modal
+      title={allowed ? 'Разрешить персонально' : 'Запретить персонально'}
+      onClose={onClose}
+      locked={busy}
